# Copie para .env e preencha. Nenhum valor real entra neste arquivo.

# Banco: PostgreSQL. Em desenvolvimento, um Postgres local:
#   createdb financas_dev
#   DATABASE_URL="postgresql://SEU_USUARIO@localhost:5432/financas_dev"
# Em produção (Neon): a connection string do pooler (hostname com -pooler).
DATABASE_URL="postgresql://localhost:5432/financas_dev"

# Só no Neon: a connection string direta (sem -pooler). As migrations usam esta;
# o pooler não aguenta o Prisma Migrate. Sem ela, vale a DATABASE_URL.
# DATABASE_URL_UNPOOLED=""

# Banco só dos testes (os testes apagam tudo dele; o nome precisa ter "test").
# Sem a variável, os testes usam o Postgres local: financas_teste.
# DATABASE_URL_TESTE="postgresql://SEU_USUARIO@localhost:5432/financas_teste"

# Segredo de assinatura do JWT. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Tempo de vida do token de acesso, em segundos.
JWT_TTL_SEGUNDOS="900"

# Pasta do log da aplicacao (um arquivo app-AAAA-MM-DD.log por dia, descartado
# apos 90 dias). Sem a variavel, usa logs/ na raiz; vazio desliga o arquivo.
# Na Vercel o disco não persiste: deixe vazio (LOG_DIR="") para logar só no console.
# LOG_DIR="logs"
