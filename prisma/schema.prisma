// Modelo base do template. As entidades de domínio do projeto entram
// depois, nas features do B4 — este arquivo é o ponto de partida.

generator client {
  provider = "prisma-client"
  output   = "../src/gerado/prisma"
}

datasource db {
  provider = "postgresql"
}

// A família é o dono dos dados: toda linha de negócio pertence a uma família, e
// nenhuma consulta atravessa de uma para outra. Quem se cadastra cria a sua.
model Familia {
  id       String   @id @default(cuid())
  nome     String
  criadoEm DateTime @default(now())

  usuarios     Usuario[]
  atividades   Atividade[]
  categorias   Categoria[]
  lancamentos  Lancamento[]
  recorrencias Recorrencia[]
  filhos       Filho[]
  movimentos   MovimentoDeMesada[]

  @@map("familias")
}

model Usuario {
  id        String  @id @default(cuid())
  nome      String
  email     String  @unique
  senhaHash String
  papel     String  @default("usuario") // "admin" | "usuario"
  ativo     Boolean @default(true)

  avatar              String? // JSON do avatar desenhado (src/lib/avatar.ts); nulo até a pessoa escolher
  // Toda sessão emitida depois deste instante é válida; é assim que a troca de senha derruba as outras (L4).
  sessoesValidasDesde DateTime @default(now())

  familiaId String

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  familia Familia @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  filho   Filho?

  @@index([familiaId])
  @@map("usuarios")
}

// Trilha de atividade (PR-10): quem fez, o quê e quando. Só acréscimo (PR-11).
// Sem chave estrangeira para `usuarios` de propósito: o registro sobrevive à
// conta (exclusão de verdade na FT-07, PR-09) e guarda o nome do ator como
// estava na hora. O `detalhe` é um JSON plano e pequeno e nunca recebe
// senha, hash, token nem dado financeiro (PR-25); o serviço recusa.
model Atividade {
  id         String   @id @default(cuid())
  atorId     String
  atorNome   String
  acao       String // código do catálogo em src/lib/atividade.ts
  entidade   String // "usuario", e depois "lancamento", "mesada"...
  entidadeId String
  detalhe    String? // JSON plano, ver acima
  familiaId  String
  criadoEm   DateTime @default(now())

  familia Familia @relation(fields: [familiaId], references: [id], onDelete: Restrict)

  @@index([criadoEm])
  @@index([familiaId])
  @@map("atividades")
}

// Lançamentos da casa (FT-03). Todo valor é inteiro em centavos, BRL, sempre
// positivo: o sinal vem do tipo (PR-02, PR-26). Nunca Float nem Decimal.
// `data` é o dia civil da família como texto AAAA-MM-DD, não um instante
// (PR-16, PR-26). Quem lançou fica na trilha de atividade, não aqui.
model Categoria {
  id        String   @id @default(cuid())
  nome      String
  tipo      String // "receita" | "despesa"
  familiaId String
  criadoEm  DateTime @default(now())

  familia      Familia       @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  lancamentos  Lancamento[]
  recorrencias Recorrencia[]

  // Nome único dentro do tipo e da família; a comparação sem diferenciar
  // maiúscula é do serviço (PR-27).
  @@unique([familiaId, tipo, nome])
  @@map("categorias")
}

model Lancamento {
  id            String   @id @default(cuid())
  tipo          String // "receita" | "despesa"
  valorCentavos Int // inteiro positivo, em centavos de real
  data          String // AAAA-MM-DD no fuso America/Sao_Paulo
  descricao     String   @default("")
  categoriaId   String
  // Quem da família fez o gasto (ou recebeu): o id do `Usuario` adulto ou do
  // `Filho`. Opcional, sem chave estrangeira: o lançamento sobrevive à pessoa.
  pessoaId      String?
  // Pago (despesa) ou recebido (receita). O que já existia nasce pago.
  pago          Boolean  @default(true)
  // Se este lançamento é um mês de uma recorrência, qual. Apagar a recorrência
  // solta os lançamentos em vez de apagá-los.
  recorrenciaId String?
  familiaId     String
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  familia     Familia      @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  categoria   Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  recorrencia Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  // Um mês de uma recorrência só existe uma vez, mesmo com duas telas
  // gerando ao mesmo tempo. Nulo não conta: lançamento avulso repete à vontade.
  @@unique([recorrenciaId, data])
  @@index([familiaId, data])
  @@index([pessoaId])
  @@index([recorrenciaId])
  @@map("lancamentos")
}

// Filhos da família (FT-05). Só o que a PR-09 permite para dado de menor:
// nome, nascimento opcional (dia civil AAAA-MM-DD), e a mesada combinada, que é
// apenas informativa (PR-30): valor em centavos inteiros (PR-02) e
// periodicidade "semanal" | "mensal". Nenhum CPF, RG, telefone, endereço nem
// foto. O login é opcional: um `Usuario` de papel `filho` ligado 1 para 1
// (PR-31). Sem `onDelete: Cascade`: apagar a conta não leva o registro do
// filho; a exclusão de verdade é da FT-07.
model Filho {
  id             String   @id @default(cuid())
  nome           String
  nascimento     String? // AAAA-MM-DD no fuso America/Sao_Paulo
  mesadaCentavos Int // inteiro positivo, em centavos de real; informativo
  periodicidade  String // "semanal" | "mensal"
  usuarioId      String?  @unique
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
  avatar         String? // JSON do avatar desenhado (src/lib/avatar.ts); nulo até o responsável escolher
  familiaId      String
  familia        Familia  @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  movimentos MovimentoDeMesada[]

  @@index([familiaId])
  @@map("filhos")
}

// Movimentos de mesada (FT-06, PR-32 e PR-33). Crédito ou gasto de um filho,
// em centavos inteiros positivos, BRL (PR-02): o sinal vem do tipo e nunca
// Float nem Decimal. `data` é o dia civil como texto AAAA-MM-DD (PR-26). O
// saldo não é guardado: é sempre a soma dos créditos menos a dos gastos,
// calculada no servidor. A chave estrangeira usa Cascade de propósito: apagar
// o filho leva o histórico dele (PR-09), e a FT-07 exporta e apaga por filho
// com uma consulta por `filhoId`.
model MovimentoDeMesada {
  id            String   @id @default(cuid())
  filhoId       String
  tipo          String // "credito" | "gasto"
  valorCentavos Int // inteiro positivo, em centavos de real
  data          String // AAAA-MM-DD no fuso America/Sao_Paulo
  descricao     String   @default("")
  familiaId     String
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  familia Familia @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  filho   Filho   @relation(fields: [filhoId], references: [id], onDelete: Cascade)

  @@index([filhoId, data])
  @@index([familiaId])
  @@map("movimentos_de_mesada")
}

// Lançamento que se repete todo mês (por exemplo, a conta de luz no dia 5). É o
// modelo dos meses seguintes: cada mês vira um `Lancamento` ligado a ele, em
// aberto. `geradoAte` é o último mês já criado, e é o que impede de recriar um
// mês que a pessoa apagou. `fim`, se houver, é o último mês que ainda vale.
model Recorrencia {
  id            String   @id @default(cuid())
  tipo          String // "receita" | "despesa"
  valorCentavos Int
  diaDoMes      Int // 1 a 31; em mês mais curto vale o último dia
  descricao     String   @default("")
  categoriaId   String
  pessoaId      String?
  inicio        String // AAAA-MM
  fim           String? // AAAA-MM
  geradoAte     String // AAAA-MM
  familiaId     String
  criadoEm      DateTime @default(now())

  familia     Familia      @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  categoria   Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  lancamentos Lancamento[]

  @@index([familiaId])
  @@map("recorrencias")
}
