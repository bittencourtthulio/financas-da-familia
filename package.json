{
  "name": "financas-da-familia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verificar": "npm run lint && npm run typecheck && npm run build && npm test && npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "backup": "tsx scripts/backup.ts",
    "restaurar": "tsx scripts/restaurar.ts",
    "log:limpar": "tsx scripts/limpar-logs.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "12.11.1",
    "dotenv": "17.4.2",
    "jose": "6.2.10",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "vite": "8.3.5",
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.9",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    }
  }
}
